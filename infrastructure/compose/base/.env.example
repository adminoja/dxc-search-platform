# Copy this to the appropriate env file per environment.
# Local example:
#   cp infrastructure/compose/base/.env.example infrastructure/compose/local/.env.local

# Database
PG_DB=searchdb
PG_USER=search
PG_PASSWORD=searchpw

# MinIO
MINIO_ROOT_USER=miniominiouser
MINIO_ROOT_PASSWORD=miniominiosecret
MINIO_BUCKET=pdf

# App profile
SPRING_PROFILES_ACTIVE=local

# Image tag (only used in prod; local build overrides it)
SEARCH_PLATFORM_IMAGE=local
