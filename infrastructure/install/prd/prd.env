# === General ===
TZ=Asia/Bangkok
SPRING_PROFILES_ACTIVE=prd

# === Image tags ===
APP_TAG=1.0.3
GOTENBERG_TAG=8.9.0

# === Host reachability (Pattern 1 with fixed IP) ===
HOST_IP=10.14.33.70

# === Ports (use Spring's canonical vars) ===
SERVER_PORT=8081
MANAGEMENT_SERVER_PORT=8082
# Optional: expose actuator at a custom path (default /actuator)
MANAGEMENT_BASE_PATH=/actuator

# (Optional compatibility: only keep these if your compose still references them)
# APP_PORT=${SERVER_PORT}
# MANAGEMENT_PORT=${MANAGEMENT_SERVER_PORT}

# === Eureka / SBA behavior ===
EUREKA_URIS=http://cloud-registry-01.ad.thaidxc.org:8761/eureka/,http://cloud-registry-02.ad.thaidxc.org:8761/eureka/
EUREKA_NONSECURE_ENABLED=true
EUREKA_SECURE_ENABLED=false

# === TLS toggles (HTTP-only)
APP_SSL_ENABLED=false
MANAGEMENT_SSL_ENABLED=false
# If you ever switch to HTTPS, also provide APP_SECURE_PORT / MANAGEMENT_SECURE_PORT

# === Gotenberg ===
GOTENBERG_PORT=3000

# === Resources (8-GB host suggestion) ===
APP_CPUS_LIMIT=2.0
APP_CPUS_RES=0.25
APP_MEM_LIMIT=3072M
APP_MEM_RES=256M

GOTENBERG_CPUS_LIMIT=2.0
GOTENBERG_CPUS_RES=0.25
GOTENBERG_MEM_LIMIT=1536M
GOTENBERG_MEM_RES=256M

# === Paketo JVM auto-tuning (no JAVA_TOOL_OPTIONS) ===
BPL_JVM_HEAP_RATIO=70
BPL_JVM_HEAD_ROOM=10

# === Logging ===
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# === Certificates ===
HOST_CERTS_DIR=/srv/dxc-search-platform/certs
