TZ=Asia/Bangkok
SPRING_PROFILES_ACTIVE=prd
APP_NAME=dxc-search-platform
LOG_LEVEL=info

HTTP_CONNECT_TIMEOUT=5000
HTTP_READ_TIMEOUT=30000

CACHE_L1_TTL_SECONDS=900
CACHE_L2_TTL_SECONDS=14400
RUN_STATUS_TTL_SECONDS=172800

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC -Duser.timezone=Asia/Bangkok
